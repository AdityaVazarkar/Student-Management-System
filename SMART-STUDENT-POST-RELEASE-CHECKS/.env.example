# Environment Selection: 'dev' or 'uat' (or 'local')
ENVIRONMENT=dev

# === DEV ENVIRONMENT CONFIGURATION ===
DEV_APP_URL=http://localhost:3000
DEV_API_URL=http://localhost:8080/api
DEV_TEACHER_EMAIL=teacher@school.com
DEV_TEACHER_PASSWORD=admin123
DEV_STUDENT_EMAIL=alex@student.com
DEV_STUDENT_PASSWORD=student123

# === UAT ENVIRONMENT CONFIGURATION ===
UAT_APP_URL=http://localhost:3000
UAT_API_URL=http://localhost:8080/api
UAT_TEACHER_EMAIL=teacher@school.com
UAT_TEACHER_PASSWORD=admin123
UAT_STUDENT_EMAIL=alex@student.com
UAT_STUDENT_PASSWORD=student123

# Default fallback URLs & timeouts
APP_URL=http://localhost:3000
API_URL=http://localhost:8080/api
TIMEOUT=30000
CI=true
