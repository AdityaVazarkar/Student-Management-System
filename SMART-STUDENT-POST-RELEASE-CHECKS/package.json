{
  "name": "smart-student-post-release-checks",
  "version": "1.0.0",
  "description": "Automated post-release verification, smoke checks, and quality-gate testing suite for Student Portal & API in Jenkins CI/CD pipeline",
  "main": "playwright.config.js",
  "scripts": {
    "test": "./node_modules/.bin/playwright test",
    "test:critical": "./node_modules/.bin/playwright test --grep \"@critical\"",
    "test:prod-safe": "./node_modules/.bin/playwright test --grep \"@prod-safe\"",
    "test:api": "./node_modules/.bin/playwright test tests/api",
    "test:ui": "./node_modules/.bin/playwright test tests/ui",
    "test:health": "./node_modules/.bin/playwright test tests/health",
    "test:journeys": "./node_modules/.bin/playwright test tests/journeys",
    "test:all": "node scripts/wait-for-deployment.js && ./node_modules/.bin/playwright test && node scripts/calculate-score.js",
    "wait:ready": "node scripts/wait-for-deployment.js",
    "cleanup": "node scripts/cleanup-test-data.js",
    "calculate-score": "node scripts/calculate-score.js",
    "publish:summary": "node scripts/publish-summary.js"
  },
  "keywords": [
    "jenkins",
    "ci-cd",
    "pipeline",
    "smoke-tests",
    "playwright",
    "post-release-checks",
    "quality-gate",
    "student-portal"
  ],
  "author": "DevOps & Quality Engineering",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.4.7"
  }
}
